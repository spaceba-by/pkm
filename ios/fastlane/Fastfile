default_platform(:ios)

platform :ios do
  # ================================
  # Setup & Configuration
  # ================================

  before_all do
    setup_ci if ENV['CI']
    ENV['FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT'] ||= '60'
  end

  # ================================
  # Testing Lanes
  # ================================

  desc "Run all tests (unit + UI)"
  lane :test do
    run_tests(
      project: "PKMReader.xcodeproj",
      scheme: "PKMReader",
      devices: ["iPhone 16"],
      code_coverage: true,
      result_bundle: true,
      output_directory: "TestResults",
      xcargs: "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO"
    )
  end

  desc "Run unit tests only"
  lane :unit_tests do
    run_tests(
      project: "PKMReader.xcodeproj",
      scheme: "PKMReader",
      devices: ["iPhone 16"],
      only_testing: ["PKMReaderTests"],
      code_coverage: true,
      result_bundle: true,
      output_directory: "TestResults/unit",
      xcargs: "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO"
    )
  end

  desc "Run UI tests only"
  lane :ui_tests do
    run_tests(
      project: "PKMReader.xcodeproj",
      scheme: "PKMReader",
      devices: ["iPhone 16"],
      only_testing: ["PKMReaderUITests"],
      result_bundle: true,
      output_directory: "TestResults/ui",
      xcargs: "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO"
    )
  end

  desc "Run performance tests only"
  lane :performance_tests do
    run_tests(
      project: "PKMReader.xcodeproj",
      scheme: "PKMReader",
      devices: ["iPhone 16"],
      only_testing: ["PKMReaderTests/PerformanceTests"],
      result_bundle: true,
      output_directory: "TestResults/performance",
      xcargs: "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO"
    )
  end

  # ================================
  # Code Quality Lanes
  # ================================

  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      config_file: ".swiftlint.yml",
      strict: true,
      raise_if_swiftlint_error: true
    )
  end

  desc "Auto-fix SwiftLint issues"
  lane :lint_fix do
    swiftlint(
      mode: :fix,
      config_file: ".swiftlint.yml"
    )
  end

  desc "Run SwiftFormat"
  lane :format do
    sh("cd .. && swiftformat . --config .swiftformat")
  end

  desc "Check code formatting"
  lane :format_check do
    sh("cd .. && swiftformat . --config .swiftformat --lint")
  end

  # ================================
  # Build Lanes
  # ================================

  desc "Build for development"
  lane :build_dev do
    build_app(
      project: "PKMReader.xcodeproj",
      scheme: "PKMReader",
      configuration: "Debug",
      skip_codesigning: true,
      skip_archive: true,
      destination: "generic/platform=iOS Simulator"
    )
  end

  desc "Build release archive"
  lane :build_release do
    # Increment build number
    increment_build_number(
      build_number: ENV['BUILD_NUMBER'] || Time.now.strftime("%Y%m%d%H%M")
    )

    # Sync signing certificates (only when not skipping)
    unless ENV['SKIP_CODESIGNING']
      sync_code_signing(
        type: "appstore",
        readonly: is_ci
      )

      # Switch the main target to manual signing with the Match profile.
      # This only modifies PKMReader target — SPM packages keep automatic
      # signing and won't fail with "requires a development team".
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "PKMReader.xcodeproj",
        team_id: "TPXD65QGEQ",
        profile_name: ENV['sigh_by.spaceba.pkm.reader_appstore_profile-name'],
        code_sign_identity: "Apple Distribution",
        targets: ["PKMReader"]
      )
    end

    build_app(
      project: "PKMReader.xcodeproj",
      scheme: "PKMReader",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "PKMReader.ipa",
      skip_codesigning: ENV['SKIP_CODESIGNING'] == 'true'
    )
  end

  # ================================
  # Deployment Lanes
  # ================================

  desc "Upload to TestFlight"
  lane :upload_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY'],
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/PKMReader.ipa",
      skip_waiting_for_build_processing: true,
      changelog: last_git_commit[:message]
    )
  end

  # ================================
  # Submission Lanes
  # ================================

  desc "Validate App Store metadata and prepare submission"
  lane :prepare_submission do
    metadata_dir = "metadata/en-US"
    required_files = %w[name.txt subtitle.txt description.txt keywords.txt release_notes.txt support_url.txt privacy_url.txt]

    required_files.each do |file|
      path = File.join(metadata_dir, file)
      UI.user_error!("Missing metadata file: #{file}") unless File.exist?(path)
      UI.user_error!("Empty metadata file: #{file}") if File.read(path).strip.empty?
    end

    keywords = File.read(File.join(metadata_dir, "keywords.txt")).strip
    UI.user_error!("Keywords exceed 100 characters (#{keywords.length})") if keywords.length > 100

    name = File.read(File.join(metadata_dir, "name.txt")).strip
    UI.user_error!("App name exceeds 30 characters (#{name.length})") if name.length > 30

    subtitle = File.read(File.join(metadata_dir, "subtitle.txt")).strip
    UI.user_error!("Subtitle exceeds 30 characters (#{subtitle.length})") if subtitle.length > 30

    UI.success("All metadata files validated successfully")

    screenshots_dir = "screenshots/en-US"
    if Dir.exist?(screenshots_dir) && !Dir.glob(File.join(screenshots_dir, "*.png")).empty?
      UI.success("Screenshots found in #{screenshots_dir}")
    else
      UI.important("No screenshots found. Run `fastlane snapshot` to capture them.")
    end

    UI.success("Submission preparation complete. Review metadata before uploading.")
  end

  # ================================
  # Utility Lanes
  # ================================

  desc "Generate code coverage report"
  lane :coverage_report do
    # Run tests with coverage enabled
    run_tests(
      project: "PKMReader.xcodeproj",
      scheme: "PKMReader",
      devices: ["iPhone 16"],
      code_coverage: true,
      result_bundle: true,
      output_directory: "TestResults/coverage",
      xcargs: "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO"
    )
    # Extract coverage using xccov
    sh("cd .. && xcrun xccov view --report --json TestResults/coverage/PKMReader.xcresult > coverage.json")
  end

  desc "Generate Xcode project from project.yml"
  lane :generate_project do
    sh("cd .. && xcodegen generate")
  end

  desc "Setup project for new developer"
  lane :setup do
    sh("../Scripts/bootstrap.sh")
  end
end
