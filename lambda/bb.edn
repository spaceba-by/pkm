{:paths ["shared" "tests"
         "functions/extract_metadata"
         "functions/classify_document"
         "functions/extract_entities"
         "functions/generate_daily_summary"
         "functions/generate_weekly_report"
         "functions/api_list_documents"
         "functions/api_get_document"
         "functions/api_search"
         "functions/api_list_tags"
         "functions/api_documents_by_tag"
         "functions/api_list_classifications"
         "functions/api_list_summaries"
         "functions/api_list_reports"
         "functions/api_update_classification"
         "functions/api_bulk_reclassify"
         "functions/bulk_reclassify"
         "functions/delete_document"
         "functions/persistent_search_execute"
         "functions/persistent_search_summarize"
         "functions/api_search_monitors"
         "functions/api_search_monitor_detail"
         "functions/api_search_summaries"]
 :deps {clj-commons/clj-yaml {:mvn/version "1.0.27"}
        org.clojure/data.json {:mvn/version "2.4.0"}
        org.babashka/http-client {:mvn/version "0.4.19"}
        ;; AWS deps for REPL development
        com.grzm/awyeah-api {:git/url "https://github.com/grzm/awyeah-api"
                            :git/sha "e5513349a2fd8a980a62bbe0d45a0d55bfcea141"}
        com.cognitect.aws/endpoints {:mvn/version "1.1.12.772"}
        com.cognitect.aws/s3 {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/dynamodb {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/lambda {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/bedrock-runtime {:mvn/version "871.2.30.11"}}

 :tasks
 {clean {:doc "Clean build artifacts"
         :task (shell "rm -rf functions/*/bootstrap functions/*/*.zip")}

  lint {:doc "Lint Clojure sources with clj-kondo"
        :task (shell "clj-kondo --lint shared functions --fail-level error")}

  test {:doc "Run tests"
        :task (shell "bb -cp" (str (with-out-str (babashka.deps/clojure ["-Spath"])) ":shared:tests") "-m" "test-runner")}

  repl {:doc "Start nREPL server for development"
        :task (shell "bb --nrepl-server")}}}
